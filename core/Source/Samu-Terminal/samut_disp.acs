function void STBuilder_ShowBanner(void){
	if(!STB_IsActive()) return;
	HudPushState();
	HudResetState();
	HudSetTimes();
	HUDSetTextColor(CR_GREEN);
	HUDSetPoint(Vars_Mid_Wid(), 8.0);
	HudSetAlign(HUD_ALIGN_CENTER, HUD_ALIGN_TOP);
	HUDSetFont("DBIGFONT");
	str txt = "BUILD MODE";
	if(STB_IsPlacing()) txt = StrParam(s:"BUILD MODE - ", s:STBuilder_TypeName(stbuilder_state[STBS_PLACETYPE]));
	HUDDrawText(ST_HID_BUILDER, txt);
	HudPopState();
}

// Context-sensitive on-screen help, bottom-left, while build mode is on.
function void STBuilder_ShowHelp(void){
	if(!STB_IsActive()) return;
	str txt;
	int col = CR_WHITE;
	if(STB_IsPlacing()){
		txt = StrParam(s:"Place: ", s:STBuilder_TypeName(stbuilder_state[STBS_PLACETYPE]),
			s:"   |   Attack: place   Jump/Crouch: cycle   Use: cancel");
		col = CR_GREEN;
	} else if(stbuilder_drag[0]){
		txt = "Drag: release the click to drop";
		col = CR_BLUE;
	} else {
		txt = "Select: Click   |   Interact: AltFire   |   Drag: Hold click\nMove: Forward/Back/Left/Right (hold Speed = fine step)";
		col = CR_GOLD;
	}
	txt = StrParam(s:txt, s:"\nChat: !add  !delete  !copy  !paste  !dup  !clear  !undo  !redo  !set-prop  !get-prop  !vis  !overlay  !tooltip  !export");
	HudPushState();
	HudResetState();
	HudSetTimes();
	HUDSetTextColor(col);
	HudSetAlign(HUD_ALIGN_LEFT, HUD_ALIGN_BOTTOM);
	HUDSetPoint(8.0, STSET_HEIGHT - 8.0);
	HUDSetFont("SMALLFONT");
	HudSetScale(0.5);
	HUDDrawText(ST_HID_BUILDER_HELP, txt);
	HudPopState();
}

function void STBuilder_ShowOutline(void){
	if(stbuilder_state[STBS_SELTYPE] == STBUILDER_NONE) return;
	int rect = STBuilder_CompRect(stbuilder_state[STBS_SELTYPE], stbuilder_state[STBS_SELID]);
	if(rect == -1) return;
	int x1 = STBuilder_HitX1(stbuilder_state[STBS_SELTYPE], stbuilder_state[STBS_SELID]);
	int y1 = STBuilder_HitY1(stbuilder_state[STBS_SELTYPE], stbuilder_state[STBS_SELID]);
	int x2 = x1 + STBuilder_HitWidth(stbuilder_state[STBS_SELTYPE], stbuilder_state[STBS_SELID]);
	int y2 = y1 + STBuilder_HitHeight(stbuilder_state[STBS_SELTYPE], stbuilder_state[STBS_SELID]);
	HudPushState();
	HudResetState();
	HudSetTimes();
	HUDSetTextColor(stbuilder_drag[0] ? CR_BLUE : CR_YELLOW);
	HUDSetFont("SMALLFONT");
	HudSetAlign(HUD_ALIGN_LEFT, HUD_ALIGN_TOP);
	HUDSetPoint(x1 - 4.0, y1 - 4.0); HUDDrawText(ST_HID_BUILDER_OUT + 0, "+");
	HUDSetPoint(x2 - 4.0, y1 - 4.0); HUDDrawText(ST_HID_BUILDER_OUT + 1, "+");
	HUDSetPoint(x1 - 4.0, y2 - 4.0); HUDDrawText(ST_HID_BUILDER_OUT + 2, "+");
	HUDSetPoint(x2 - 4.0, y2 - 4.0); HUDDrawText(ST_HID_BUILDER_OUT + 3, "+");
	HudPopState();
}

function void STBuilder_ShowGhost(void){
	if(!STB_IsPlacing()) return;
	HudPushState();
	HudResetState();
	HudSetTimes();
	HUDSetTextColor(CR_GREEN);
	HUDSetFont("SMALLFONT");
	HudSetAlign(HUD_ALIGN_CENTER, HUD_ALIGN_CENTER);
	HUDSetPoint(CursorX(), CursorY());
	HUDDrawText(ST_HID_BUILDER_OUT + 4, StrParam(s:"[", s:STBuilder_TypeName(stbuilder_state[STBS_PLACETYPE]), s:"]"));
	HudPopState();
}

// Marks every movable component with a small marker at the top-left of its
// hitbox while build mode is active. Green = visible/selectable, gray = not
// visible (ghost). Panel children are ignored; the panel itself is marked.
function void STBuilder_ShowMarkers(void){
	if(!STB_IsActive()){
		if(stbuilder_state[STBS_MARKERPREV] > 0) STBuilder_ClearMarkers();
		return;
	}
	int marker = 0;
	int order[5] = {STCOMP_IBTN, STCOMP_SBTN, STCOMP_LBL, STCOMP_IMG, STCOMP_PANEL};
	HudPushState();
	HudResetState();
	HudSetTimes();
	HUDSetFont("SMALLFONT");
	HudSetAlign(HUD_ALIGN_LEFT, HUD_ALIGN_TOP);
	bool full = false;
	for(int o = 0; o < 5 && !full; o++){
		int type = order[o];
		for(int id = 0; id < comp_count[type]; id++){
			bool visible = STBuilder_IsVisible(type, id);
			if(!visible && !STBuilder_ShouldGhost(type, id)) continue;
			if(visible) HUDSetTextColor(CR_GREEN);
			else HUDSetTextColor(CR_GRAY);
			HUDSetPoint(STBuilder_HitX1(type, id), STBuilder_HitY1(type, id));
			HUDDrawText(ST_HID_BUILDER_MARK + marker, "+");
			marker++;
			if(marker >= 1900){ full = true; break; }
		}
	}
	// Clear any marker HIDs left over from the previous frame (deletions,
	// ghost toggle, etc.) so no orphan "+" stays on screen.
	for(int i = marker; i < stbuilder_state[STBS_MARKERPREV]; i++)
		ClearHudMessage(ST_HID_BUILDER_MARK + i);
	stbuilder_state[STBS_MARKERPREV] = marker;
	HudPopState();
}

// Debug overlay: prints type#id, tag and size at each component's hitbox.
// Only drawn while the overlay toggle is on.
function void STBuilder_ShowOverlay(void){
	if(!STB_IsActive() || !STB_IsOverlay()){
		if(stbuilder_state[STBS_DBGPREV] > 0){
			for(int i = 0; i < stbuilder_state[STBS_DBGPREV]; i++) ClearHudMessage(ST_HID_BUILDER_DBG + i);
			stbuilder_state[STBS_DBGPREV] = 0;
		}
		return;
	}
	int marker = 1; // index 0 is reserved for the debug header
	int order[5] = {STCOMP_IBTN, STCOMP_SBTN, STCOMP_LBL, STCOMP_IMG, STCOMP_PANEL};
	HudPushState();
	HudResetState();
	HudSetTimes();
	HUDSetFont("SMALLFONT");
	HudSetAlign(HUD_ALIGN_LEFT, HUD_ALIGN_TOP);
	HudSetScale(0.5);
	// Debug header: the current page tag and the home (alpha) tag.
	HUDSetTextColor(CR_CYAN);
	HUDSetPoint(8.0, 24.0);
	HUDDrawText(ST_HID_BUILDER_DBG + 0, StrParam(s:"page tag: ", d:pagetags[STTAGS_NOW], s:"   alpha tag: ", d:pagetags[STTAGS_ALPHA]));
	for(int o = 0; o < 5 && marker < 200; o++){
		int type = order[o];
		for(int id = 0; id < comp_count[type] && marker < 200; id++){
			if(STBuilder_IsDead(type, id)) continue;
			bool visible = STBuilder_IsVisible(type, id);
			if(!visible && !STBuilder_ShouldGhost(type, id)) continue;
			int tag = STBuilder_GetCompTag(type, id);
			if(visible && tag == pagetags[STTAGS_NOW]) HUDSetTextColor(CR_GREEN);
			else if(visible) HUDSetTextColor(CR_GOLD);
			else HUDSetTextColor(CR_GRAY);
			HUDSetPoint(STBuilder_HitX1(type, id), STBuilder_HitY1(type, id));
			HUDDrawText(ST_HID_BUILDER_DBG + marker, StrParam(s:STBuilder_TypeName(type), s:"#", d:id,
				s:" t", d:tag, s:" ", d:STBuilder_HitWidth(type, id) >> 16, s:"x", d:STBuilder_HitHeight(type, id) >> 16));
			marker++;
		}
	}
	for(int ci = marker; ci < stbuilder_state[STBS_DBGPREV]; ci++)
		ClearHudMessage(ST_HID_BUILDER_DBG + ci);
	stbuilder_state[STBS_DBGPREV] = marker;
	HudPopState();
}

//////////////////////////////////////
// The display core loop			//
//////////////////////////////////////

function void SamuTerm_Display(void){
	ShowBackground();
	// One spawned script for all component types (was 5 spawns per tic).
	ACS_NamedExecuteAlways("SamuTerm_Display_All", 0);

	//if(Prompt_GetState()) ShowPrompt();
	if(Prompt_GetState()) ShowPanel(prompt_data[STPROMPT_DATA_PANEL]);
	ShowCursor();
	STBuilder_ShowMarkers();
	STBuilder_ShowOverlay();
	STBuilder_ShowGhost();
	STBuilder_ShowOutline();
	STBuilder_ShowBanner();
	STBuilder_ShowHelp();
}

function void SamuTerm_Display_Comp(int type, int id){
	switch(type){
		case STCOMP_IBTN: if(ImgButton_GetParent(id) == -1) ShowImgButton(id); break;
		case STCOMP_SBTN: if(StrButton_GetParent(id) == -1) ShowStrButton(id); break;
		case STCOMP_LBL: if(Label_GetParent(id) == -1) ShowLabel(id); break;
		case STCOMP_IMG: if(Image_GetParent(id) == -1) ShowImage(id); break;
		case STCOMP_PANEL: ShowPanel(id); break;
	}
}

Script "SamuTerm_Display_All" (void) Clientside{
	int i;
	for(i = 0; i < comp_count[STCOMP_IBTN]; i++) SamuTerm_Display_Comp(STCOMP_IBTN, i);
	for(i = 0; i < comp_count[STCOMP_SBTN]; i++) SamuTerm_Display_Comp(STCOMP_SBTN, i);
	for(i = 0; i < comp_count[STCOMP_LBL]; i++) SamuTerm_Display_Comp(STCOMP_LBL, i);
	for(i = 0; i < comp_count[STCOMP_IMG]; i++) SamuTerm_Display_Comp(STCOMP_IMG, i);
	for(i = 0; i < comp_count[STCOMP_PANEL]; i++) SamuTerm_Display_Comp(STCOMP_PANEL, i);
}