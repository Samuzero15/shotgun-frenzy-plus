// True if the component was auto-created by a NumInput (prev/next/label).
function bool STBuilder_IsNumInputChild(int type, int id){
	for(int i = 0; i < comp_count[STCOMP_NUMINPUT]; i++){
		if(type == STCOMP_SBTN && (NumInput_getPrevButton(i) == id || NumInput_getNextButton(i) == id)) return true;
		if(type == STCOMP_LBL && NumInput_getLabelNum(i) == id) return true;
	}
	return false;
}

// ----- per-type property emitters (shared by top-level and panel children) -----

function void STBuilder_ExpIBtnProps(int id, str var, int flags){
	Log(s:"    ImgButton_setImage(", s:var, s:", \"", s:ImgButton_getImage(id), s:"\");");
	if((flags & STBUILD_EXPF_HOVER) && StrLen(ImgButton_getHoverImage(id)) > 0)
		Log(s:"    ImgButton_setHoverImage(", s:var, s:", \"", s:ImgButton_getHoverImage(id), s:"\");");
	Log(s:"    ImgButton_setTag(", s:var, s:", ", d:ImgButton_getTag(id), s:");");
	Log(s:"    ImgButton_setExecute(", s:var, s:", ", s:STBuilder_ExecName(ImgButton_getExecute(id)), s:");");
	Log(s:"    ImgButton_setArgs(", s:var, s:", ", d:ImgButton_getExeArg1(id), s:", ",
		d:ImgButton_getExeArg2(id), s:", ", d:ImgButton_getExeArg3(id), s:");");
	Log(s:"    ImgButton_setColor(", s:var, s:", ", s:STBuilder_ColorExpr(ImgButton_getColor(id)), s:");");
	if(flags & STBUILD_EXPF_TOGGLE){
		int itog = ImgButton_GetIsToggleable(id);
		if(itog != ST_BTNTYPE_NORMAL){
			Log(s:"    ImgButton_SetIsToggleable(", s:var, s:", ", s:STBuilder_ToggleName(itog), s:");");
			Log(s:"    ImgButton_SetToggleState(", s:var, s:", ", d:ImgButton_GetToggleState(id), s:");");
			Log(s:"    ImgButton_SetGroup(", s:var, s:", ", d:ImgButton_GetGroup(id), s:");");
		}
	}
	if((flags & STBUILD_EXPF_OFFSETS) && (ImgButton_getOffsetX(id) != 0 || ImgButton_getOffsetY(id) != 0))
		Log(s:"    ImgButton_setOffsets(", s:var, s:", ", f:ImgButton_getOffsetX(id), s:", ", f:ImgButton_getOffsetY(id), s:");");
	Log(s:"    ImgButton_setShow(", s:var, s:", true);");
}

function void STBuilder_ExpSBtnProps(int id, str var, int flags){
	Log(s:"    StrButton_setColor(", s:var, s:", ", s:STBuilder_ColorExpr(StrButton_getColor(id)), s:");");
	Log(s:"    StrButton_setTag(", s:var, s:", ", d:StrButton_getTag(id), s:");");
	Log(s:"    StrButton_setExecute(", s:var, s:", ", s:STBuilder_ExecName(StrButton_getExecute(id)), s:");");
	Log(s:"    StrButton_setExeArgs(", s:var, s:", ", d:StrButton_getExeArg1(id), s:", ",
		d:StrButton_getExeArg2(id), s:", ", d:StrButton_getExeArg3(id), s:");");
	if((flags & STBUILD_EXPF_HOVER) && StrButton_getExeHover(id) != 0){
		Log(s:"    StrButton_setExeHover(", s:var, s:", ", s:STBuilder_ExecName(StrButton_getExeHover(id)), s:");");
		Log(s:"    StrButton_setExeHoverArgs(", s:var, s:", ", d:StrButton_getExeHoverArg1(id), s:", ",
			d:StrButton_getExeHoverArg2(id), s:", ", d:StrButton_getExeHoverArg3(id), s:");");
	}
	if(flags & STBUILD_EXPF_TOGGLE){
		int stog = StrButton_GetIsToggleable(id);
		if(stog != ST_BTNTYPE_NORMAL){
			Log(s:"    StrButton_SetIsToggleable(", s:var, s:", ", s:STBuilder_ToggleName(stog), s:");");
			Log(s:"    StrButton_SetToggleState(", s:var, s:", ", d:StrButton_GetToggleState(id), s:");");
			Log(s:"    StrButton_SetGroup(", s:var, s:", ", d:StrButton_GetGroup(id), s:");");
		}
	}
	if((flags & STBUILD_EXPF_OFFSETS) && (StrButton_getOffsetX(id) != 0 || StrButton_getOffsetY(id) != 0))
		Log(s:"    StrButton_setOffsets(", s:var, s:", ", f:StrButton_getOffsetX(id), s:", ", f:StrButton_getOffsetY(id), s:");");
	Log(s:"    StrButton_setShow(", s:var, s:", true);");
}

function void STBuilder_ExpLabelProps(int id, str var, int flags){
	Log(s:"    Label_setText(", s:var, s:", \"", s:Label_getText(id), s:"\");");
	Log(s:"    Label_setFont(", s:var, s:", \"", s:Label_getFont(id), s:"\");");
	Log(s:"    Label_setColor(", s:var, s:", ", s:STBuilder_ColorExpr(Label_getColor(id)), s:");");
	Log(s:"    Label_setTag(", s:var, s:", ", d:Label_getTag(id), s:");");
	Log(s:"    Label_setAligns(", s:var, s:", ", s:STBuilder_AlignXName(Label_getAlignX(id)), s:", ",
		s:STBuilder_AlignYName(Label_getAlignY(id)), s:");");
	if((flags & STBUILD_EXPF_OFFSETS) && (Label_getOffsetX(id) != 0 || Label_getOffsetY(id) != 0))
		Log(s:"    Label_setOffsets(", s:var, s:", ", f:Label_getOffsetX(id), s:", ", f:Label_getOffsetY(id), s:");");
	Log(s:"    Label_setShow(", s:var, s:", true);");
}

function void STBuilder_ExpImageProps(int id, str var, int flags){
	Log(s:"    Image_setTag(", s:var, s:", ", d:Image_getTag(id), s:");");
	Log(s:"    Image_setAligns(", s:var, s:", ", s:STBuilder_AlignXName(Image_getAlignX(id)), s:", ",
		s:STBuilder_AlignYName(Image_getAlignY(id)), s:");");
	Log(s:"    Image_setScale(", s:var, s:", ", f:Image_getScaleX(id), s:", ", f:Image_getScaleY(id), s:");");
	if((flags & STBUILD_EXPF_OFFSETS) && (Image_getOffsetX(id) != 0 || Image_getOffsetY(id) != 0))
		Log(s:"    Image_setOffsets(", s:var, s:", ", f:Image_getOffsetX(id), s:", ", f:Image_getOffsetY(id), s:");");
	Log(s:"    Image_setShow(", s:var, s:", true);");
}

function void STBuilder_ExpPanelProps(int pid, str var, int flags){
	Log(s:"    Panel_SetTitle(", s:var, s:", \"", s:Panel_GetTitle(pid), s:"\");");
	Log(s:"    Panel_setColor(", s:var, s:", ", s:STBuilder_ColorExpr(Panel_getColor(pid)), s:");");
	Log(s:"    Panel_setTag(", s:var, s:", ", d:Panel_GetTag(pid), s:");");
	Log(s:"    Panel_SetAnchors(", s:var, s:", ", s:STBuilder_AnchorNameX(Panel_GetAnchorX(pid)), s:", ",
		s:STBuilder_AnchorNameY(Panel_GetAnchorY(pid)), s:");");
	Log(s:"    Panel_SetColumns(", s:var, s:", ", d:Panel_GetColumns(pid), s:");");
	Log(s:"    Panel_SetSpacing(", s:var, s:", ", f:Panel_GetSpacingX(pid), s:", ", f:Panel_GetSpacingY(pid), s:");");
	Log(s:"    Panel_SetVirtualSize(", s:var, s:", ", f:Panel_GetVirtualWidth(pid), s:", ", f:Panel_GetVirtualHeight(pid), s:");");
	Log(s:"    Panel_SetScrollAmount(", s:var, s:", ", f:Panel_GetScrollX(pid), s:", ", f:Panel_GetScrollY(pid), s:");");
	Log(s:"    Panel_SetAutoscroll(", s:var, s:", ", d:Panel_GetAutoscroll(pid), s:");");
	Log(s:"    Panel_setShow(", s:var, s:", true);");
}

function void STBuilder_ExpNumInputProps(int id, str var, int flags){
	Log(s:"    NumInput_setTag(", s:var, s:", ", d:NumInput_getTag(id), s:");");
	Log(s:"    NumInput_SetBtnDistance(", s:var, s:", ", f:NumInput_GetBtnDistance(id), s:");");
	Log(s:"    NumInput_SetValue(", s:var, s:", ", d:NumInput_GetValue(id), s:");");
	Log(s:"    NumInput_SetMinValue(", s:var, s:", ", d:NumInput_GetMinValue(id), s:");");
	Log(s:"    NumInput_SetMaxValue(", s:var, s:", ", d:NumInput_GetMaxValue(id), s:");");
	Log(s:"    NumInput_SetStepValue(", s:var, s:", ", d:NumInput_GetStepValue(id), s:");");
	Log(s:"    NumInput_SetShowNumber(", s:var, s:", ", d:NumInput_GetShowNumber(id), s:");");
	Log(s:"    NumInput_SetLabelText(", s:var, s:", \"", s:NumInput_GetLabelText(id), s:"\");");
	Log(s:"    NumInput_setColor(", s:var, s:", ", s:STBuilder_ColorExpr(NumInput_getColor(id)), s:");");
	Log(s:"    NumInput_setLoopValues(", s:var, s:", ", d:NumInput_GetLoopValues(id), s:");");
	Log(s:"    NumInput_setShow(", s:var, s:", true);");
}

// Dumps the exported components as ready-to-paste ACS, split into
// INIT / UPDATE / EXECUTE batches. `flags` selects what gets exported.
function void STBuilder_Export(int flags){
	int tag = pagetags[STTAGS_NOW];
	bool markers = !(flags & STBUILD_EXPF_NOMARKERS);
	if(markers){
		Log(s:"// ===== STBUILDER-EXPORT-TAG-", d:tag, s:" =====");
		Log(s:"// STBuilder export - page tag ", d:tag, s:" - flags ", d:flags);
		Log(s:"// Tip: run 'logfile stbuilder_export.txt' in the console before exporting to save it to a file.");
		Log(s:"");
	}

	// -------------------- BATCH 1: INIT --------------------
	if(markers) Log(s:"// BATCH 1 - INIT: component definitions");
	Log(s:"function void STBuilder_Page_", d:tag, s:"_Init(void){");

	// IButtons (top-level)
	for(int id = 0; id < comp_count[STCOMP_IBTN]; id++){
		if(STBuilder_HasParent(STCOMP_IBTN, id)) continue;
		if(!STBuilder_ExportInclude(STCOMP_IBTN, id, flags)) continue;
		int rect = STBuilder_CompRect(STCOMP_IBTN, id);
		Log(s:"    int ibtn_", d:id, s:" = ImgButton_Add(",
			f:RectX1(rect), s:", ", f:RectY1(rect), s:", ",
			f:RectWidth(rect), s:", ", f:RectHeight(rect), s:");");
		STBuilder_ExpIBtnProps(id, StrParam(s:"ibtn_", d:id), flags);
		Log(s:"");
	}

	// String buttons (top-level)
	for(int sid = 0; sid < comp_count[STCOMP_SBTN]; sid++){
		if(STBuilder_HasParent(STCOMP_SBTN, sid)) continue;
		if(STBuilder_IsNumInputChild(STCOMP_SBTN, sid)) continue;
		if(!STBuilder_ExportInclude(STCOMP_SBTN, sid, flags)) continue;
		int srect = STBuilder_CompRect(STCOMP_SBTN, sid);
		Log(s:"    int sbtn_", d:sid, s:" = StrButton_Add(", f:RectX1(srect), s:", ", f:RectY1(srect),
			s:", \"", s:StrButton_getText(sid), s:"\");");
		STBuilder_ExpSBtnProps(sid, StrParam(s:"sbtn_", d:sid), flags);
		Log(s:"");
	}

	// Labels (top-level)
	for(int lid = 0; lid < comp_count[STCOMP_LBL]; lid++){
		if(STBuilder_HasParent(STCOMP_LBL, lid)) continue;
		if(STBuilder_IsNumInputChild(STCOMP_LBL, lid)) continue;
		if(!STBuilder_ExportInclude(STCOMP_LBL, lid, flags)) continue;
		int lrect = STBuilder_CompRect(STCOMP_LBL, lid);
		Log(s:"    int lbl_", d:lid, s:" = Label_Add(", f:RectX1(lrect), s:", ", f:RectY1(lrect), s:");");
		STBuilder_ExpLabelProps(lid, StrParam(s:"lbl_", d:lid), flags);
		Log(s:"");
	}

	// Images (top-level)
	for(int iid = 0; iid < comp_count[STCOMP_IMG]; iid++){
		if(STBuilder_HasParent(STCOMP_IMG, iid)) continue;
		if(!STBuilder_ExportInclude(STCOMP_IMG, iid, flags)) continue;
		int irect = STBuilder_CompRect(STCOMP_IMG, iid);
		Log(s:"    int img_", d:iid, s:" = Image_Add(", f:RectX1(irect), s:", ", f:RectY1(irect),
			s:", \"", s:Image_getFile(iid), s:"\");");
		STBuilder_ExpImageProps(iid, StrParam(s:"img_", d:iid), flags);
		Log(s:"");
	}

	// Panels and their children
	for(int pid = 0; pid < comp_count[STCOMP_PANEL]; pid++){
		if(!STBuilder_ExportInclude(STCOMP_PANEL, pid, flags)) continue;
		int prect = STBuilder_CompRect(STCOMP_PANEL, pid);
		int wx8 = ((RectWidth(prect) >> 16) - 16) / 8;
		int hx8 = ((RectHeight(prect) >> 16) - 16) / 8;
		Log(s:"    int pn_", d:pid, s:" = Panel_Add(", f:RectX1(prect), s:", ", f:RectY1(prect),
			s:", ", d:wx8, s:", ", d:hx8, s:");");
		STBuilder_ExpPanelProps(pid, StrParam(s:"pn_", d:pid), flags);
		Log(s:"");
		for(int ci = 0; ci < Panel_GetNumberOfComps(pid); ci++){
			int ctype = panels_comps_index[pid][ci][STPANEL_COMPDATA_TYPE];
			int cid = panels_comps_index[pid][ci][STPANEL_COMPDATA_ID];
			if(!STBuilder_ExportInclude(ctype, cid, flags)) continue;
			int relx = STBuilder_OriginX(ctype, cid) - Panel_GetClipX1(pid);
			int rely = STBuilder_OriginY(ctype, cid) - Panel_GetClipY1(pid);
			switch(ctype){
				case STCOMP_IBTN:
					Log(s:"    int ibtn_", d:cid, s:" = ImgButton_AddToPanelAbs(",
						f:RectWidth(STBuilder_CompRect(ctype, cid)), s:", ", f:RectHeight(STBuilder_CompRect(ctype, cid)),
						s:", pn_", d:pid, s:", ", f:relx, s:", ", f:rely, s:");");
					STBuilder_ExpIBtnProps(cid, StrParam(s:"ibtn_", d:cid), flags);
				break;
				case STCOMP_SBTN:
					Log(s:"    int sbtn_", d:cid, s:" = StrButton_AddToPanelAbs(\"", s:StrButton_getText(cid),
						s:"\", pn_", d:pid, s:", ", f:relx, s:", ", f:rely, s:");");
					STBuilder_ExpSBtnProps(cid, StrParam(s:"sbtn_", d:cid), flags);
				break;
				case STCOMP_LBL:
					Log(s:"    int lbl_", d:cid, s:" = Label_AddToPanelAbs(pn_", d:pid, s:", ", f:relx, s:", ", f:rely, s:");");
					STBuilder_ExpLabelProps(cid, StrParam(s:"lbl_", d:cid), flags);
				break;
				case STCOMP_IMG:
					Log(s:"    int img_", d:cid, s:" = Image_AddToPanelAbs(\"", s:Image_getFile(cid),
						s:"\", pn_", d:pid, s:", ", f:relx, s:", ", f:rely, s:");");
					STBuilder_ExpImageProps(cid, StrParam(s:"img_", d:cid), flags);
				break;
			}
			Log(s:"");
		}
	}

	// NumInputs
	for(int nid = 0; nid < comp_count[STCOMP_NUMINPUT]; nid++){
		if(!STBuilder_ExportInclude(STCOMP_NUMINPUT, nid, flags)) continue;
		int nrect = STBuilder_CompRect(STCOMP_NUMINPUT, nid);
		Log(s:"    int ni_", d:nid, s:" = NumInput_Add(", f:RectX1(nrect), s:", ", f:RectY1(nrect), s:");");
		STBuilder_ExpNumInputProps(nid, StrParam(s:"ni_", d:nid), flags);
		Log(s:"");
	}

	Log(s:"}");
	Log(s:"");

	// -------------------- BATCH 2: UPDATE --------------------
	if(markers) Log(s:"// BATCH 2 - UPDATE: visibility / logic for components using STEXE_*");
	Log(s:"function void STBuilder_Page_", d:tag, s:"_Update(void){");
	bool any_upd = false;
	for(int uid = 0; uid < comp_count[STCOMP_IBTN]; uid++){
		if(!STBuilder_ExportInclude(STCOMP_IBTN, uid, flags)) continue;
		int uexe = ImgButton_getExecute(uid);
		if(uexe == 0) continue;
		Log(s:"    // ibtn_", d:uid, s:" -> ", s:STBuilder_ExecName(uexe), s:"  (update its visibility/logic here)");
		any_upd = true;
	}
	for(int usid = 0; usid < comp_count[STCOMP_SBTN]; usid++){
		if(STBuilder_IsNumInputChild(STCOMP_SBTN, usid)) continue;
		if(!STBuilder_ExportInclude(STCOMP_SBTN, usid, flags)) continue;
		int usexe = StrButton_getExecute(usid);
		if(usexe == 0) continue;
		Log(s:"    // sbtn_", d:usid, s:" -> ", s:STBuilder_ExecName(usexe), s:"  (update its visibility/logic here)");
		any_upd = true;
	}
	if(!any_upd) Log(s:"    // (no components with an execute)");
	Log(s:"}");
	Log(s:"");

	// -------------------- BATCH 3: EXECUTE --------------------
	if(markers) Log(s:"// BATCH 3 - EXECUTE: custom execute handlers (register with SamuTerm_RegisterScriptExec)");
	int seen[64];
	int seen_n = 0;
	bool any_exec = false;
	for(int eid = 0; eid < comp_count[STCOMP_IBTN]; eid++){
		if(!STBuilder_ExportInclude(STCOMP_IBTN, eid, flags)) continue;
		int exe = ImgButton_getExecute(eid);
		if(exe == 0) continue;
		bool dup = false;
		for(int s = 0; s < seen_n; s++) if(seen[s] == exe){ dup = true; break; }
		if(dup) continue;
		if(seen_n < 64) seen[seen_n++] = exe;
		any_exec = true;
		str ename = STBuilder_ExecName(exe);
		str regname = SamuTerm_GetScriptExecName(exe);
		Log(s:"// ", s:ename, s:" (used by ibtn_", d:eid, s:")");
		if(StrLen(regname) > 0) Log(s:"//   originally handled by: \"", s:regname, s:"\"");
		Log(s:"SamuTerm_RegisterScriptExec(", s:ename, s:", \"STBuilder_Page_", d:tag, s:"_Exec_", s:ename, s:"\");");
		Log(s:"script \"STBuilder_Page_", d:tag, s:"_Exec_", s:ename, s:"\" (int arg1, int arg2, int arg3){");
		Log(s:"    // TODO: implement ", s:ename, s:" logic here.");
		Log(s:"}");
		Log(s:"");
	}
	for(int esid = 0; esid < comp_count[STCOMP_SBTN]; esid++){
		if(STBuilder_IsNumInputChild(STCOMP_SBTN, esid)) continue;
		if(!STBuilder_ExportInclude(STCOMP_SBTN, esid, flags)) continue;
		int sexe = StrButton_getExecute(esid);
		if(sexe == 0) continue;
		bool sdup = false;
		for(int s2 = 0; s2 < seen_n; s2++) if(seen[s2] == sexe){ sdup = true; break; }
		if(sdup) continue;
		if(seen_n < 64) seen[seen_n++] = sexe;
		any_exec = true;
		str sname = STBuilder_ExecName(sexe);
		str sreg = SamuTerm_GetScriptExecName(sexe);
		Log(s:"// ", s:sname, s:" (used by sbtn_", d:esid, s:")");
		if(StrLen(sreg) > 0) Log(s:"//   originally handled by: \"", s:sreg, s:"\"");
		Log(s:"SamuTerm_RegisterScriptExec(", s:sname, s:", \"STBuilder_Page_", d:tag, s:"_Exec_", s:sname, s:"\");");
		Log(s:"script \"STBuilder_Page_", d:tag, s:"_Exec_", s:sname, s:"\" (int arg1, int arg2, int arg3){");
		Log(s:"    // TODO: implement ", s:sname, s:" logic here.");
		Log(s:"}");
		Log(s:"");
	}
	if(!any_exec) Log(s:"// (no custom executes)");
	if(markers) Log(s:"// ===== end STBUILDER-EXPORT-TAG-", d:tag, s:" =====");
	STBuilder_Notify("STBuilder: export written to the console/log.", CR_GREEN);
}

// Works regardless of the script's activator (server-triggered clientside
// scripts may be activated by the world, not the player).
function bool STBuilder_LocalInTerminal(void){
	int play = ConsolePlayerNumber();	if(play < 0) return false;
	return CheckActorInventory(CONST_TID_PLAYER + play, "SamuTInv_UsingTerminal");
}

// Sets the terminal background for this session (reset on reopen).
function void STBuilder_SetBg(str name){
	if(StrLen(name) == 0){
		STBuilder_Notify("STBuilder: usage !bg <patch>", CR_RED);
		return;
	}
	imgbg = name;
	STBuilder_Notify(StrParam(s:"STBuilder: background set to \"", s:name, s:"\"."), CR_GREEN);
}

// Moves the builder to another tag (affects visibility, placement and export).
function void STBuilder_SetTag(int tag){
	pagetags[STTAGS_NOW] = tag;
	STBuilder_Notify(StrParam(s:"STBuilder: now on tag ", d:tag, s:"."), CR_GOLD);
}

script "STBuilder_ChatNet" (int s) CLIENTSIDE {
	if(GameType() != GAME_SINGLE_PLAYER) terminate;
	if(!STBuilder_LocalInTerminal()){ STBuilder_Notify("STBuilder: open the terminal first.", CR_RED); terminate; }
	str body = s;
	StrSplit(body, " ");
	str kw = r1;
	str rest = r2;

	if(StrICmp(kw, "add") == 0){
		STBuilder_Add(STBuilder_KeywordToType(rest));
	} else if(StrICmp(kw, "delete") == 0 || StrICmp(kw, "del") == 0){
		STBuilder_Delete();
	} else if(StrICmp(kw, "clear") == 0 || StrICmp(kw, "cancel") == 0){
		STBuilder_Clear();
	} else if(StrICmp(kw, "set-prop") == 0 || StrICmp(kw, "set") == 0){
		STBuilder_SetProp(rest);
	} else if(StrICmp(kw, "get-prop") == 0 || StrICmp(kw, "get") == 0){
		STBuilder_GetProp(rest);
	} else if(StrICmp(kw, "toggle-visibility") == 0 || StrICmp(kw, "vis") == 0 || StrICmp(kw, "ghost") == 0){
		STBuilder_ToggleVisibility();
	} else if(StrICmp(kw, "export") == 0){
		STBuilder_Export(STBuilder_ParseExportFlags(rest));
	} else if(StrICmp(kw, "bg") == 0 || StrICmp(kw, "background") == 0){
		STBuilder_SetBg(rest);
	} else if(StrICmp(kw, "set-tag") == 0){
		STBuilder_SetTag(STBuilder_StrToInt(rest));
	} else if(StrICmp(kw, "undo") == 0){
		STBuilder_Undo();
	} else if(StrICmp(kw, "redo") == 0){
		STBuilder_Redo();
	} else if(StrICmp(kw, "copy") == 0){
		STBuilder_Copy();
	} else if(StrICmp(kw, "paste") == 0){
		STBuilder_Paste();
	} else if(StrICmp(kw, "dup") == 0 || StrICmp(kw, "duplicate") == 0){
		STBuilder_Duplicate();
	} else if(StrICmp(kw, "toggle-tooltip") == 0 || StrICmp(kw, "tooltip") == 0){
		STBuilder_ToggleTooltip();
	} else if(StrICmp(kw, "overlay") == 0 || StrICmp(kw, "debug") == 0){
		STBuilder_ToggleOverlay();
	} else {
		STBuilder_Notify(StrParam(s:"STBuilder: unknown command '", s:kw, s:"'. Try: add, delete, copy, paste, dup, clear, undo, redo, set-prop, get-prop, toggle-visibility, toggle-tooltip, overlay, export, bg, set-tag."), CR_RED);
	}
}
