// Reverse lookups so the export prints symbolic names, not magic numbers.
function str STBuilder_ColorName(int c){
	switch(c){
		case CR_UNTRANSLATED: return "CR_UNTRANSLATED";
		case CR_BRICK: return "CR_BRICK";
		case CR_TAN: return "CR_TAN";
		case CR_GRAY: return "CR_GRAY";
		case CR_GREEN: return "CR_GREEN";
		case CR_BROWN: return "CR_BROWN";
		case CR_GOLD: return "CR_GOLD";
		case CR_RED: return "CR_RED";
		case CR_BLUE: return "CR_BLUE";
		case CR_ORANGE: return "CR_ORANGE";
		case CR_WHITE: return "CR_WHITE";
		case CR_YELLOW: return "CR_YELLOW";
		case CR_CYAN: return "CR_CYAN";
		case CR_PURPLE: return "CR_PURPLE";
		case CR_BLACK: return "CR_BLACK";
		case CR_DARKGREEN: return "CR_DARKGREEN";
		case CR_DARKRED: return "CR_DARKRED";
		case CR_DARKBROWN: return "CR_DARKBROWN";
		case CR_DARKGRAY: return "CR_DARKGRAY";
		case CR_LIGHTBLUE: return "CR_LIGHTBLUE";
		case CR_TEAL: return "CR_TEAL";
		case CR_OLIVE: return "CR_OLIVE";
		case CR_CREAM: return "CR_CREAM";
		case CR_FIRE: return "CR_FIRE";
		case CR_ICE: return "CR_ICE";
		case CR_SAPPHIRE: return "CR_SAPPHIRE";
	}
	return StrParam(d:c);
}

