function str STBuilder_ColorExpr(int c){
	if(c > 25) return StrParam(s:"\"", s:c, s:"\""); // string color
	return STBuilder_ColorName(c);
}

// Parses keyword export flags (space separated). Unknown words are ignored.
// Keywords: visible, currenttag, alphatag, tag0, alltags, offsets, hover,
//           toggle, nomarkers.
function int STBuilder_ParseExportFlags(str keywords){
	int flags = 0;
	int start = 0;
	int len = StrLen(keywords);
	for(int i = 0; i <= len; i++){
		if(i == len || GetChar(keywords, i) == ' '){
			if(i > start){
				str kw = StrMid(keywords, start, i - start);
				if(StrICmp(kw, "visible") == 0) flags |= STBUILD_EXPF_VISIBLE;
				else if(StrICmp(kw, "currenttag") == 0 || StrICmp(kw, "current") == 0) flags |= STBUILD_EXPF_CURRENTTAG;
				else if(StrICmp(kw, "alphatag") == 0 || StrICmp(kw, "alpha") == 0) flags |= STBUILD_EXPF_ALPHATAG;
				else if(StrICmp(kw, "tag0") == 0) flags |= STBUILD_EXPF_TAG0;
				else if(StrICmp(kw, "alltags") == 0 || StrICmp(kw, "all") == 0) flags |= STBUILD_EXPF_ALLTAGS;
				else if(StrICmp(kw, "offsets") == 0) flags |= STBUILD_EXPF_OFFSETS;
				else if(StrICmp(kw, "hover") == 0) flags |= STBUILD_EXPF_HOVER;
				else if(StrICmp(kw, "toggle") == 0) flags |= STBUILD_EXPF_TOGGLE;
				else if(StrICmp(kw, "nomarkers") == 0) flags |= STBUILD_EXPF_NOMARKERS;
			}
			start = i + 1;
		}
	}
	if(flags == 0) flags = STBUILD_EXPF_DEFAULT;
	return flags;
}

// Export filter: dead components are always skipped.
function bool STBuilder_ExportInclude(int type, int id, int flags){
	if(STBuilder_IsDead(type, id)) return false;
	if((flags & STBUILD_EXPF_VISIBLE) && !STBuilder_GetCompShow(type, id)) return false;
	if(!(flags & STBUILD_EXPF_ALLTAGS)){
		bool tagok = false;
		int tag = STBuilder_GetCompTag(type, id);
		if(flags & STBUILD_EXPF_CURRENTTAG){ if(tag == pagetags[STTAGS_NOW]) tagok = true; }
		if(flags & STBUILD_EXPF_ALPHATAG){ if(tag == pagetags[STTAGS_ALPHA]) tagok = true; }
		if(flags & STBUILD_EXPF_TAG0){ if(tag == 0) tagok = true; }
		if(!(flags & (STBUILD_EXPF_CURRENTTAG | STBUILD_EXPF_ALPHATAG | STBUILD_EXPF_TAG0))) tagok = true;
		if(!tagok) return false;
	}
	return true;
}

